# ── LLM / API Keys ────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL_API_KEY=""
MISTRAL_API_KEY=""
TAVILY_API_KEY=""
ALPHA_VANTAGE_API_KEY=""

# ── LangSmith (optional tracing) ──────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="AgenticChatBot"

# ── PostgreSQL (used by docker-compose db service) ────────────────────────────
POSTGRES_USER=agentic_chatbot_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=AgenticChatbot

# ── SQLAlchemy (app metadata: threads, artifacts) ─────────────────────────────
# Inside Docker: host = service name "db", port = 5432
# Outside Docker (local dev): use your local host/port
DATABASE_URL=postgresql+asyncpg://agentic_chatbot_user:changeme@db:5432/AgenticChatbot

# ── LangGraph checkpointer (agent state) ──────────────────────────────────────
# Same DB, psycopg (sync-style DSN — no +asyncpg driver prefix)
DATABASE_URL_FOR_CHECKPOINTER=postgresql://agentic_chatbot_user:changeme@db:5432/AgenticChatbot

# ── App paths ─────────────────────────────────────────────────────────────────
CHROMA_PATH=./chroma_db
UPLOADS_DIR=./uploads

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
